// ─────────────────────────────────────────
// AUDIT_LOGS
// ─────────────────────────────────────────

model AuditLog {
  id          String            @id @default(uuid()) @db.Uuid
  actionType  AuditActionType   @map("action_type")
  entityType  String            @db.VarChar(50)
  entityId    String            @db.Uuid
  changes     Json?
  description String?           @db.VarChar(500)
  ipAddress   String?           @map("ip_address") @db.VarChar(50)
  userAgent   String?           @map("user_agent")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz

  tenantId  String @map("tenant_id") @db.Uuid
  createdBy String @map("created_by") @db.Uuid

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUser User   @relation("AuditCreatedBy", fields: [createdBy], references: [id])

  @@index([tenantId])
  @@index([createdBy])
  @@index([actionType])
  @@index([entityType])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ─────────────────────────────────────────
// IMPORT_LOGS
// ─────────────────────────────────────────

model ImportLog {
  id          String       @id @default(uuid()) @db.Uuid
  entityType  String       @map("entity_type") @db.VarChar(50)
  fileName    String       @map("file_name") @db.VarChar(300)
  totalRows   Int          @default(0) @map("total_rows")
  successRows Int          @default(0) @map("success_rows")
  failedRows  Int          @default(0) @map("failed_rows")
  status      ImportStatus @default(pending)
  errorLog    Json?        @map("error_log")
  isDeleted   Boolean      @default(false) @map("is_deleted")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  finishedAt  DateTime?    @map("finished_at") @db.Timestamptz
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz

  importedById String @map("imported_by") @db.Uuid
