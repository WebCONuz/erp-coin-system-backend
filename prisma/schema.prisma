generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum TenantType {
  learning_center
  school
  academic_lyceum
  college
  university
}

enum CoinDirection {
  earn
  deduct
}

enum TriggerType {
  auto
  manual
}

enum SessionType {
  lesson
  exam
  competition
  extra
}

// Sessiya qanday tekshiriladi: attendance — yo'qlama + uy vazifasi (coin qoidadan),
// scored — har bir o'quvchiga ball va coin alohida kiritiladi
enum EvaluationMode {
  attendance
  scored
}

// Yo'qlama holati: present — keldi, late — kechikdi, excused — sababli kelmadi
// (coin ham, jarima ham yo'q), absent — sababsiz kelmadi (jarima qoidasi bo'lsa)
enum AttendanceStatus {
  present
  late
  excused
  absent
}

enum RewardType {
  digital
  privilege
  physical
}

enum PurchaseStatus {
  pending
  approved
  delivered
  cancelled
}

enum SourceType {
  attendance
  late
  homework
  competition
  exam
  manual
  bonus
  purchase
}

enum Weekday {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

enum SmsRecipientType {
  student
  parent
}

enum SmsStatus {
  pending
  sent
  failed
}

enum EmailStatus {
  pending
  sent
  failed
}

enum SmsTriggerType {
  absence
  schedule_updated
  custom
  performance_alert
}

enum EmailTriggerType {
  absence
  schedule_updated
  custom
  performance_alert
  reward_update
}

enum RoleScope {
  system
  tenant
}

enum AuditActionType {
  create
  update
  delete
  archive
  restore
  assign
  approve
  reject
  coin_transaction
  sms_sent
  email_sent
}

// ─────────────────────────────────────────
// TENANTS
// ─────────────────────────────────────────

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(200)
  slug      String   @unique @db.VarChar(100)
  plan      String   @default("basic") @db.VarChar(50)
  type      TenantType? @map("tenant_type")
  // Teacher bitta tranzaksiyada (har bir o'quvchiga) bera oladigan maksimal coin.
  // null — cheklov yo'q. Tenant admini sozlaydi (PATCH /tenant-settings).
  teacherCoinLimit Int? @map("teacher_coin_limit")
  // IANA timezone — "bugun", "dars boshlandimi", tahrirlash muddati shu bo'yicha hisoblanadi
  timezone  String   @default("Asia/Tashkent") @db.VarChar(64)
  isActive  Boolean  @default(true) @map("is_active")
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  users              User[]
  courses            Course[]
  subjects           Subject[]
  groups             Group[]
  rooms              Room[]
  coinRules          CoinRule[]
  rewards            Reward[]
  sessions           Session[]
  scheduleTemplates  ScheduleTemplate[]
  smsTemplates       SmsTemplate[]
  emailTemplates     EmailTemplate[]
  smsLogs            SmsLog[]
  emailLogs          EmailLog[]
  rewardCategories   RewardCategory[]
  holidays           Holiday[]
  coinTransactions   CoinTransaction[]
  purchases          Purchase[]
  attendanceRecords  AttendanceRecord[]
  roles              Role[]
  auditLogs          AuditLog[]
  idempotencyKeys    IdempotencyKey[]

  @@map("tenants")
}

// ─────────────────────────────────────────
// ROLES (ruxsatlar rol `level` i bilan tekshiriladi — RolesGuard, user-hierarchy)
// ─────────────────────────────────────────

model Role {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(50)
  displayName     String   @map("display_name") @db.VarChar(100)
  level           Int      @default(1) @db.SmallInt
  scope           RoleScope @default(tenant)
  isActive        Boolean  @default(true) @map("is_active")
  isDeleted       Boolean  @default(false) @map("is_deleted")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  tenantId String? @map("tenant_id") @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  users       User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

// ─────────────────────────────────────────
// USERS
// ─────────────────────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique @db.VarChar(30)
  phone        String    @db.VarChar(20)
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name") @db.VarChar(150)
  email        String?   @db.VarChar(150)
  avatarUrl    String?   @map("avatar_url")
  parentPhone  String?   @map("parent_phone") @db.VarChar(20)
  isActive     Boolean   @default(true) @map("is_active")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz
  archivedById String?   @map("archived_by") @db.Uuid
  createdById  String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  // Bir martalik tiklash tokenining sha256 hash'i (token o'zi faqat emailda)
  passwordResetToken   String?   @map("password_reset_token")
  passwordResetExpiry  DateTime? @map("password_reset_expiry") @db.Timestamptz

  tenantId String @map("tenant_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       Role   @relation(fields: [roleId], references: [id])
  createdBy  User?  @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[] @relation("UserCreatedBy")
  archivedBy User?  @relation("UserArchivedBy", fields: [archivedById], references: [id])
  archivedUsers User[] @relation("UserArchivedBy")

  wallet                    Wallet?
  refreshSessions           RefreshSession[]
  idempotencyKeys           IdempotencyKey[]
  taughtGroups              Group[]             @relation("GroupTeacher")
  createdGroups             Group[]             @relation("GroupCreatedBy")
  groupMemberships          GroupStudent[]      @relation("StudentMembership")
  addedGroupStudents        GroupStudent[]      @relation("AddedByUser")
  ledSessions               Session[]
  attendanceRecorded        AttendanceRecord[]  @relation("RecordedByUser")
  attendanceAsStudent       AttendanceRecord[]  @relation("StudentAttendance")
  coinTransactionsReceived  CoinTransaction[]   @relation("StudentTransactions")
  coinTransactionsGiven     CoinTransaction[]   @relation("TeacherTransactions")
  coinRulesCreated          CoinRule[]
  rewardsCreated            Reward[]
  purchases                 Purchase[]          @relation("StudentPurchases")
  purchasesApproved         Purchase[]          @relation("ApprovedByUser")
  purchasesDelivered        Purchase[]          @relation("DeliveredByUser")
  createdCourses            Course[]
  createdSubjects           Subject[]
  smsLogsAsStudent          SmsLog[]            @relation("SmsStudent")
  smsLogsSentBy             SmsLog[]            @relation("SmsSentBy")
  emailLogsAsStudent        EmailLog[]          @relation("EmailStudent")
  emailLogsSentBy           EmailLog[]          @relation("EmailSentBy")
  scheduleTemplatesCreated  ScheduleTemplate[]  @relation("ScheduleTemplateCreatedBy")
  scheduledTemplates        ScheduleTemplate[]  @relation("ScheduleTemplateTeacher")
  scheduleExceptionsCreated ScheduleException[]
  smsTemplatesCreated       SmsTemplate[]
  emailTemplatesCreated     EmailTemplate[]
  rewardCategories          RewardCategory[]
  auditLogsCreatedBy        AuditLog[]          @relation("AuditCreatedBy")
  holidaysCreated           Holiday[]
  substituteExceptions      ScheduleException[] @relation("ExceptionSubstituteTeacher")

  // Telefon faqat tenant ichida unique — turli tenantlarda bir xil raqamli alohida userlar bo'lishi mumkin
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([phone])
  @@index([email])
  @@index([roleId])
  @@map("users")
}

// ─────────────────────────────────────────
// REFRESH_SESSIONS (har bir login — alohida qurilma sessiyasi)
// ─────────────────────────────────────────

model RefreshSession {
  id                String    @id @default(uuid()) @db.Uuid
  // Joriy refresh tokenning sha256 hash'i (token yuqori entropiyali — bcrypt shart emas)
  tokenHash         String    @unique @map("token_hash") @db.VarChar(64)
  // Oldingi token hash'i — bir vaqtdagi parallel refresh (bir nechta tab) uchun qisqa muhlat
  previousTokenHash String?   @map("previous_token_hash") @db.VarChar(64)
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  userAgent         String?   @map("user_agent") @db.VarChar(300)
  ipAddress         String?   @map("ip_address") @db.VarChar(64)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt        DateTime  @default(now()) @map("last_used_at") @db.Timestamptz

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}

// ─────────────────────────────────────────
// WALLETS
// ─────────────────────────────────────────

model Wallet {
  id        String   @id @default(uuid()) @db.Uuid
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions CoinTransaction[]

  @@index([balance(sort: Desc)])
  @@map("wallets")
}

// ─────────────────────────────────────────
// COURSES
// ─────────────────────────────────────────

model Course {
  id           String    @id @default(uuid()) @db.Uuid
  title        String    @db.VarChar(200)
  description  String?
  isActive     Boolean   @default(true) @map("is_active")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz
  archivedById String?   @map("archived_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  tenantId    String @map("tenant_id") @db.Uuid
  createdById String @map("created_by") @db.Uuid

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  groups Group[]

  @@index([tenantId])
  @@map("courses")
}

// ─────────────────────────────────────────
// SUBJECTS (fanlar — dars jadvali va sessiyalarga bog'lanadi;
// Course/Group'dan mustaqil, ixtiyoriy: maktab uchun kerak,
// o'quv markaz uchun ishlatilmasligi mumkin)
// ─────────────────────────────────────────

model Subject {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(150)
  description  String?
  isActive     Boolean   @default(true) @map("is_active")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz
  archivedById String?   @map("archived_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  tenantId    String @map("tenant_id") @db.Uuid
  createdById String @map("created_by") @db.Uuid

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  scheduleTemplates ScheduleTemplate[]
  sessions          Session[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("subjects")
}

// ─────────────────────────────────────────
// ROOMS
// ─────────────────────────────────────────

model Room {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  capacity    Int      @default(50) @db.SmallInt
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sessions        Session[]
  scheduleTemplates ScheduleTemplate[]
  scheduleExceptions ScheduleException[]

  @@index([tenantId])
  @@map("rooms")
}

// ─────────────────────────────────────────
// GROUPS
// ─────────────────────────────────────────

model Group {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(150)
  maxStudents  Int       @default(50) @map("max_students") @db.SmallInt
  isActive     Boolean   @default(true) @map("is_active")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz
  archivedById String?   @map("archived_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  tenantId    String @map("tenant_id") @db.Uuid
  courseId    String @map("course_id") @db.Uuid
  teacherId   String @map("teacher_id") @db.Uuid
  createdById String @map("created_by") @db.Uuid

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course    Course @relation(fields: [courseId], references: [id])
  teacher   User   @relation("GroupTeacher", fields: [teacherId], references: [id])
  createdBy User   @relation("GroupCreatedBy", fields: [createdById], references: [id])

  students          GroupStudent[]
  sessions          Session[]
  coinRules         CoinRule[]
  transactions      CoinTransaction[]
  scheduleTemplates ScheduleTemplate[]

  @@index([tenantId])
  @@index([courseId])
  @@index([teacherId])
  @@map("groups")
}

// ─────────────────────────────────────────
// GROUP_STUDENTS
// ─────────────────────────────────────────

model GroupStudent {
  id         String    @id @default(uuid()) @db.Uuid
  isActive   Boolean   @default(true) @map("is_active")
  isDeleted  Boolean   @default(false) @map("is_deleted")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz
  joinedAt   DateTime  @default(now()) @map("joined_at") @db.Timestamptz
  // Guruhdan chiqarilgan vaqt — shu vaqtgacha bo'lgan darslarda o'quvchi yo'qlamada qoladi
  leftAt     DateTime? @map("left_at") @db.Timestamptz

  groupId   String  @map("group_id") @db.Uuid
  studentId String  @map("student_id") @db.Uuid
  addedById String? @map("added_by") @db.Uuid

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student User  @relation("StudentMembership", fields: [studentId], references: [id])
  addedBy User? @relation("AddedByUser", fields: [addedById], references: [id])

  @@unique([groupId, studentId])
  @@index([groupId])
  @@index([studentId])
  @@map("group_students")
}

// ─────────────────────────────────────────
// SCHEDULE_TEMPLATE
// ─────────────────────────────────────────

model ScheduleTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  weekday   Weekday
  startTime String   @map("start_time") @db.VarChar(5)
  endTime   String   @map("end_time") @db.VarChar(5)
  // Amal qilish muddati (chorak/semestr). null — cheklovsiz
  validFrom DateTime? @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date
  isActive  Boolean  @default(true) @map("is_active")
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenantId    String  @map("tenant_id") @db.Uuid
  groupId     String  @map("group_id") @db.Uuid
  roomId      String  @map("room_id") @db.Uuid
  teacherId   String? @map("teacher_id") @db.Uuid
  subjectId   String? @map("subject_id") @db.Uuid
  createdById String  @map("created_by") @db.Uuid

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id])
  room      Room     @relation(fields: [roomId], references: [id])
  teacher   User?    @relation("ScheduleTemplateTeacher", fields: [teacherId], references: [id])
  subject   Subject? @relation(fields: [subjectId], references: [id])
  createdBy User     @relation("ScheduleTemplateCreatedBy", fields: [createdById], references: [id])

  exceptions ScheduleException[]
  sessions   Session[]

  @@index([tenantId])
  @@index([groupId])
  @@index([roomId])
  @@index([subjectId])
  @@map("schedule_templates")
}

// ─────────────────────────────────────────
// SCHEDULE_EXCEPTION
// ─────────────────────────────────────────

model ScheduleException {
  id            String    @id @default(uuid()) @db.Uuid
  exceptionDate DateTime  @map("exception_date") @db.Date
  startTime     String?   @map("start_time") @db.VarChar(5)
  endTime       String?   @map("end_time") @db.VarChar(5)
  isCancelled   Boolean   @default(false) @map("is_cancelled")
  note          String?   @db.VarChar(300)
  isDeleted     Boolean   @default(false) @map("is_deleted")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  templateId  String  @map("template_id") @db.Uuid
  createdById String  @map("created_by") @db.Uuid
  // Shu kun uchun boshqa xona / o'rinbosar o'qituvchi (null — shablondagisi)
  roomId      String? @map("room_id") @db.Uuid
  teacherId   String? @map("teacher_id") @db.Uuid

  template  ScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdBy User             @relation(fields: [createdById], references: [id])
  room      Room?            @relation(fields: [roomId], references: [id])
  teacher   User?            @relation("ExceptionSubstituteTeacher", fields: [teacherId], references: [id])

  @@unique([templateId, exceptionDate])
  @@index([templateId])
  @@index([exceptionDate])
  @@map("schedule_exceptions")
}

// ─────────────────────────────────────────
// HOLIDAYS (tenant bo'yicha dam olish kunlari — shu sanada jadval darslari bo'lmaydi)
// ─────────────────────────────────────────

model Holiday {
  id        String    @id @default(uuid()) @db.Uuid
  date      DateTime  @db.Date
  name      String    @db.VarChar(200)
  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenantId    String @map("tenant_id") @db.Uuid
  createdById String @map("created_by") @db.Uuid

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  // O'chirilgan sana qayta qo'shilsa — yozuv tiklanadi
  @@unique([tenantId, date])
  @@map("holidays")
}

// ─────────────────────────────────────────
// COIN_RULES
// ─────────────────────────────────────────

model CoinRule {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(200)
  description String?
  coinAmount  Int           @map("coin_amount")
  direction   CoinDirection
  triggerType TriggerType   @default(manual) @map("trigger_type")
  sourceType  SourceType?   @map("source_type")
  isBuiltIn   Boolean       @default(false) @map("is_built_in")
  isActive    Boolean       @default(true) @map("is_active")
  isDeleted   Boolean       @default(false) @map("is_deleted")
  archivedAt  DateTime?     @map("archived_at") @db.Timestamptz
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz

  tenantId    String  @map("tenant_id") @db.Uuid
  groupId     String? @map("group_id") @db.Uuid
  createdById String  @map("created_by") @db.Uuid

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group     Group?  @relation(fields: [groupId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  transactions CoinTransaction[]

  @@index([tenantId])
  @@index([groupId])
  @@map("coin_rules")
}

// ─────────────────────────────────────────
// SESSIONS
// ─────────────────────────────────────────

model Session {
  id          String      @id @default(uuid()) @db.Uuid
  sessionDate DateTime    @map("session_date") @db.Date
  startTime   String?     @map("start_time") @db.VarChar(5)
  endTime     String?     @map("end_time") @db.VarChar(5)
  sessionType SessionType @default(lesson) @map("session_type")
  evaluationMode EvaluationMode @default(attendance) @map("evaluation_mode")
  maxScore    Int?        @map("max_score")
  topic       String?     @db.VarChar(300)
  isLocked    Boolean     @default(false) @map("is_locked")
  isChecked   Boolean     @default(false) @map("is_checked")
  // Yo'qlama/natija birinchi marta saqlangan vaqt — teacher shundan keyin 3 kun tahrirlay oladi
  checkedAt   DateTime?   @map("checked_at") @db.Timestamptz
  isDeleted   Boolean     @default(false) @map("is_deleted")
  lockedAt    DateTime?   @map("locked_at") @db.Timestamptz
  lockedById  String?     @map("locked_by") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz

  tenantId  String  @map("tenant_id") @db.Uuid
  groupId   String  @map("group_id") @db.Uuid
  roomId    String  @map("room_id") @db.Uuid
  teacherId String  @map("teacher_id") @db.Uuid
  subjectId String? @map("subject_id") @db.Uuid
  // Jadval shablonidan yaratilgan bo'lsa — qaysi shablondan (shablon o'zgarsa kelajakdagi
  // tekshirilmagan sessiyalar sinxronlanadi). Qo'lda yaratilgan sessiyada null
  templateId String? @map("template_id") @db.Uuid

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group    Group             @relation(fields: [groupId], references: [id])
  room     Room              @relation(fields: [roomId], references: [id])
  teacher  User              @relation(fields: [teacherId], references: [id])
  subject  Subject?          @relation(fields: [subjectId], references: [id])
  template ScheduleTemplate? @relation(fields: [templateId], references: [id])

  attendanceRecords AttendanceRecord[]
  transactions      CoinTransaction[]

  @@index([tenantId])
  @@index([templateId, sessionDate])
  @@index([tenantId, sessionDate])
  @@index([groupId, sessionDate(sort: Desc)])
  @@index([roomId])
  @@index([teacherId])
  @@index([subjectId])
  @@map("sessions")
}

// ─────────────────────────────────────────
// ATTENDANCE_RECORDS
// ─────────────────────────────────────────

model AttendanceRecord {
  id           String   @id @default(uuid()) @db.Uuid
  // isPresent = status in (present, late) — eski klientlar va statistika uchun sinxron saqlanadi
  isPresent    Boolean  @default(false) @map("is_present")
  status       AttendanceStatus @default(absent)
  homeworkDone Boolean  @default(false) @map("homework_done")
  score        Float?
  note         String?  @db.VarChar(500)
  recordedAt   DateTime @default(now()) @map("recorded_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  isDeleted    Boolean  @default(false) @map("is_deleted")

  sessionId    String @map("session_id") @db.Uuid
  studentId    String @map("student_id") @db.Uuid
  recordedById String @map("recorded_by") @db.Uuid
  // Tenant izolyatsiyasi DB darajasida (sessiya orqali join qilmasdan filtrlash uchun)
  tenantId     String @map("tenant_id") @db.Uuid

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session    Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student    User    @relation("StudentAttendance", fields: [studentId], references: [id])
  recordedBy User    @relation("RecordedByUser", fields: [recordedById], references: [id])

  // (sessionId, studentId) unique index sessionId bo'yicha qidiruvni ham qoplaydi
  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([tenantId])
  @@map("attendance_records")
}

// ─────────────────────────────────────────
// COIN_TRANSACTIONS
// ─────────────────────────────────────────

model CoinTransaction {
  id         String        @id @default(uuid()) @db.Uuid
  amount     Int
  direction  CoinDirection
  sourceType SourceType    @map("source_type")
  note       String?
  isDeleted  Boolean       @default(false) @map("is_deleted")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz
  deletedAt  DateTime?     @map("deleted_at") @db.Timestamptz

  walletId  String  @map("wallet_id") @db.Uuid
  studentId String  @map("student_id") @db.Uuid
  teacherId String? @map("teacher_id") @db.Uuid
  ruleId    String? @map("rule_id") @db.Uuid
  // Tenant izolyatsiyasi DB darajasida (student orqali join qilmasdan filtrlash uchun)
  tenantId  String  @map("tenant_id") @db.Uuid
  sessionId String? @map("session_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid
  // Xarid yoki xaridni bekor qilish tranzaksiyasi qaysi xaridga tegishli
  purchaseId String? @map("purchase_id") @db.Uuid
  // Teskari yozuv: bekor qilish asl yozuvni o'chirmaydi, unga qarama-qarshi yozuv qo'shadi.
  // Bitta yozuv faqat bir marta bekor qilinadi (unique).
  reversalOfId String? @unique @map("reversal_of_id") @db.Uuid

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wallet     Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  student    User             @relation("StudentTransactions", fields: [studentId], references: [id])
  teacher    User?            @relation("TeacherTransactions", fields: [teacherId], references: [id])
  rule       CoinRule?        @relation(fields: [ruleId], references: [id])
  session    Session?         @relation(fields: [sessionId], references: [id])
  group      Group?           @relation(fields: [groupId], references: [id])
  purchase   Purchase?        @relation(fields: [purchaseId], references: [id])
  reversalOf CoinTransaction? @relation("CoinReversal", fields: [reversalOfId], references: [id])
  reversal   CoinTransaction? @relation("CoinReversal")

  @@index([walletId])
  @@index([studentId, createdAt(sort: Desc)])
  @@index([teacherId])
  @@index([sessionId, studentId, sourceType])
  @@index([purchaseId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("coin_transactions")
}

// ─────────────────────────────────────────
// REWARD_CATEGORIES
// ─────────────────────────────────────────

model RewardCategory {
  id           String  @id @default(uuid()) @db.Uuid
  name         String  @db.VarChar(100)
  isActive     Boolean @default(true) @map("is_active")
  isDeleted    Boolean @default(false) @map("is_deleted")
  tenantId     String  @map("tenant_id") @db.Uuid
  createdById  String  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy  User   @relation(fields: [createdById], references: [id])
  rewards    Reward[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("reward_categories")
}

// ─────────────────────────────────────────
// REWARDS
// ─────────────────────────────────────────

model Reward {
  id           String     @id @default(uuid()) @db.Uuid
  title        String     @db.VarChar(200)
  description  String?
  coinPrice    Int        @map("coin_price")
  stock        Int        @default(-1)
  rewardType   RewardType @map("reward_type")
  imageUrl     String?    @map("image_url")
  isActive     Boolean    @default(true) @map("is_active")
  isDeleted    Boolean    @default(false) @map("is_deleted")
  archivedAt   DateTime?  @map("archived_at") @db.Timestamptz
  archivedById String?    @map("archived_by") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz

  tenantId    String @map("tenant_id") @db.Uuid
  categoryId  String @map("category_id") @db.Uuid
  createdById String @map("created_by") @db.Uuid

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category  RewardCategory @relation(fields: [categoryId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])

  purchases Purchase[]

  @@index([tenantId, isActive])
  @@map("rewards")
}

// ─────────────────────────────────────────
// PURCHASES
// ─────────────────────────────────────────

model Purchase {
  id           String         @id @default(uuid()) @db.Uuid
  coinSpent    Int            @map("coin_spent")
  status       PurchaseStatus @default(pending)
  deliveryNote String?        @map("delivery_note")
  // Xarid paytida sovg'a zaxirasidan 1 dona ayirilganmi (cheksiz sovg'ada — false).
  // Bekor qilishda faqat haqiqatda ayirilgan dona zaxiraga qaytariladi.
  stockReserved Boolean       @default(false) @map("stock_reserved")
  isDeleted    Boolean        @default(false) @map("is_deleted")
  purchasedAt  DateTime       @default(now()) @map("purchased_at") @db.Timestamptz
  deliveredAt  DateTime?      @map("delivered_at") @db.Timestamptz
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz

  studentId     String  @map("student_id") @db.Uuid
  rewardId      String  @map("reward_id") @db.Uuid
  // Tenant izolyatsiyasi DB darajasida
  tenantId      String  @map("tenant_id") @db.Uuid
  approvedById  String? @map("approved_by") @db.Uuid
  deliveredById String? @map("delivered_by") @db.Uuid

  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student     User    @relation("StudentPurchases", fields: [studentId], references: [id])
  reward      Reward  @relation(fields: [rewardId], references: [id])
  approvedBy  User?   @relation("ApprovedByUser", fields: [approvedById], references: [id])
  deliveredBy User?   @relation("DeliveredByUser", fields: [deliveredById], references: [id])

  transactions CoinTransaction[]

  @@index([studentId])
  @@index([rewardId])
  @@index([tenantId, status])
  @@map("purchases")
}

// ─────────────────────────────────────────
// SMS_TEMPLATES
// ─────────────────────────────────────────

model SmsTemplate {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(200)
  triggerType SmsTriggerType @map("trigger_type")
  body        String
  isActive    Boolean        @default(true) @map("is_active")
  isDeleted   Boolean        @default(false) @map("is_deleted")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz

  tenantId    String @map("tenant_id") @db.Uuid
  createdById String @map("created_by") @db.Uuid

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  smsLogs SmsLog[]

  @@index([tenantId])
  @@map("sms_templates")
}

// ─────────────────────────────────────────
// SMS_LOGS
// ─────────────────────────────────────────

model SmsLog {
  id            String           @id @default(uuid()) @db.Uuid
  recipientType SmsRecipientType @map("recipient_type")
  phone         String           @db.VarChar(20)
  body          String
  triggerType   SmsTriggerType   @map("trigger_type")
  status        SmsStatus        @default(pending)
  eskizMessageId String?         @map("eskiz_message_id")
  errorMessage  String?          @map("error_message")
  isDeleted     Boolean          @default(false) @map("is_deleted")
  sentAt        DateTime?        @map("sent_at") @db.Timestamptz
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  deletedAt     DateTime?        @map("deleted_at") @db.Timestamptz

  tenantId   String  @map("tenant_id") @db.Uuid
  // Qabul qiluvchi tenant useri bo'lsa (ota-ona, lid — null)
  studentId  String? @map("student_id") @db.Uuid
  templateId String? @map("template_id") @db.Uuid
  sentById   String  @map("sent_by") @db.Uuid

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student   User?        @relation("SmsStudent", fields: [studentId], references: [id])
  template  SmsTemplate? @relation(fields: [templateId], references: [id])
  sentBy    User         @relation("SmsSentBy", fields: [sentById], references: [id])

  @@index([tenantId])
  @@index([studentId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("sms_logs")
}

// ─────────────────────────────────────────
// EMAIL_TEMPLATES
// ─────────────────────────────────────────

model EmailTemplate {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @db.VarChar(200)
  triggerType EmailTriggerType @map("trigger_type")
  subject     String          @db.VarChar(300)
  body        String
  isActive    Boolean         @default(true) @map("is_active")
  isDeleted   Boolean         @default(false) @map("is_deleted")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?       @map("deleted_at") @db.Timestamptz

  tenantId    String @map("tenant_id") @db.Uuid
  createdById String @map("created_by") @db.Uuid

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  emailLogs EmailLog[]

  @@index([tenantId])
  @@map("email_templates")
}

// ─────────────────────────────────────────
// EMAIL_LOGS
// ─────────────────────────────────────────

model EmailLog {
  id             String          @id @default(uuid()) @db.Uuid
  email          String          @db.VarChar(150)
  subject        String          @db.VarChar(300)
  body           String
  triggerType    EmailTriggerType @map("trigger_type")
  status         EmailStatus     @default(pending)
  errorMessage   String?         @map("error_message")
  isDeleted      Boolean         @default(false) @map("is_deleted")
  sentAt         DateTime?       @map("sent_at") @db.Timestamptz
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz

  tenantId   String  @map("tenant_id") @db.Uuid
  // Qabul qiluvchi tenant useri bo'lsa (ota-ona, lid — null)
  studentId  String? @map("student_id") @db.Uuid
  templateId String? @map("template_id") @db.Uuid
  sentById   String  @map("sent_by") @db.Uuid

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student   User?          @relation("EmailStudent", fields: [studentId], references: [id])
  template  EmailTemplate? @relation(fields: [templateId], references: [id])
  sentBy    User           @relation("EmailSentBy", fields: [sentById], references: [id])

  @@index([tenantId])
  @@index([studentId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("email_logs")
}

// ─────────────────────────────────────────
// AUDIT_LOGS
// ─────────────────────────────────────────

model AuditLog {
  id          String            @id @default(uuid()) @db.Uuid
  actionType  AuditActionType   @map("action_type")
  entityType  String            @db.VarChar(50)
  entityId    String            @db.Uuid
  changes     Json?
  description String?           @db.VarChar(500)
  ipAddress   String?           @map("ip_address") @db.VarChar(50)
  userAgent   String?           @map("user_agent")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz

  tenantId  String @map("tenant_id") @db.Uuid
  createdBy String @map("created_by") @db.Uuid

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUser User   @relation("AuditCreatedBy", fields: [createdBy], references: [id])

  // Asosiy so'rov — tenant bo'yicha eng yangilari; entitet tarixi (?entityId=) — alohida
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, entityId])
  @@index([createdBy])
  @@index([actionType])
  @@index([entityType])
  @@map("audit_logs")
}

// ─────────────────────────────────────────
// IDEMPOTENCY_KEYS (pul kabi amallarni takroriy so'rovdan himoya: coin berish, xarid)
// ─────────────────────────────────────────

model IdempotencyKey {
  id          String   @id @default(uuid()) @db.Uuid
  // Klient yuborgan `Idempotency-Key` header'i
  key         String   @db.VarChar(100)
  // So'rov mazmuni (method + URL + body) hash'i — bir kalit boshqa so'rov uchun ishlatilmasin
  requestHash String   @map("request_hash") @db.VarChar(64)
  // null — so'rov hali bajarilmoqda; javob saqlangach takroriy so'rovga shu qaytariladi
  statusCode  Int?     @map("status_code") @db.SmallInt
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt   DateTime @map("expires_at") @db.Timestamptz

  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Kalit har bir user uchun noyob
  @@unique([tenantId, userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}